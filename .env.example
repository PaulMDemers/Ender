# Runtime
PORT=3000
AGENT_WORKDIR=./workspace
AGENT_WORKSPACE_BASE=..
AGENT_THREADS_DIR=./threads
AGENT_SCHEDULES_DIR=./schedules
AGENT_WORKFLOW_SESSIONS_DIR=./workflow-sessions
AGENT_SELF_ROOT=.
# Optional: leave blank for unbounded loop
AGENT_MAX_STEPS=
# Repeated-iteration cutoff (0 disables stall detection)
AGENT_STALL_LIMIT=4
# Auto-restart interrupted threads on server restart for all workspaces.
# Ender self-root threads auto-restart by default even when this is unset.
AGENT_AUTO_RESTART_INTERRUPTED_THREADS=false
AGENT_SELF_UPDATE_VERIFY=npm run verify
AGENT_SELF_UPDATE_TIMEOUT_MS=90000
ENDER_SUPERVISOR_URL=
ENDER_SUPERVISOR_TOKEN=
# auto prefers a local launcher on macOS and Docker elsewhere
CODE_SERVER_ENABLED=true
CODE_SERVER_MODE=auto
# Used for docker mode
CODE_SERVER_IMAGE=codercom/code-server:latest
CODE_SERVER_BIND_HOST=0.0.0.0
CODE_SERVER_PUBLIC_HOST=
CODE_SERVER_PUBLIC_PROTOCOL=
CODE_SERVER_HOST_WORKDIR=
CODE_SERVER_STATE_DIR=.ender-code-server
# Used for local mode
CODE_SERVER_COMMAND=code-server
# The pinned npm package currently expects Node 22 when used via npx
CODE_SERVER_NPX_PACKAGE=code-server@4.113.0

# Provider selection: openai | bedrock | azure | ollama
LLM_BACKEND=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# AWS Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_INSTANCE_NAME=
AZURE_OPENAI_API_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional alternative to instance name:
# AZURE_OPENAI_BASE_PATH=https://<resource>.openai.azure.com/openai/deployments

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# GitLab
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=

# GitHub
GITHUB_BASE_URL=https://github.com
GITHUB_TOKEN=

# Jira
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Confluence
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# Google Drive
GOOGLE_DRIVE_ACCESS_TOKEN=

# Email (SMTP send)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Email (IMAP list/read)
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
