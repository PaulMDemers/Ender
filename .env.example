# Runtime
PORT=3000
# Direct API access is local-only by default. Use Pillar for authenticated remote access.
# Set open only when network exposure is intentional and protected by your deployment boundary.
ENDER_API_ACCESS_MODE=local
ENDER_API_BIND_HOST=0.0.0.0
# Comma-separated browser origins. Local mode also permits loopback origins.
ENDER_CORS_ORIGINS=
ENDER_SHUTDOWN_TIMEOUT_MS=10000
AGENT_WORKDIR=./workspace
AGENT_WORKSPACE_BASE=..
AGENT_THREADS_DIR=./threads
AGENT_PROJECTS_DIR=./projects
AGENT_MEMORIES_DIR=./memories
AGENT_SCHEDULES_DIR=./schedules
AGENT_TASK_LEDGER_DIR=./task-ledger
AGENT_WORKFLOW_SESSIONS_DIR=./workflow-sessions
AGENT_SELF_ROOT=.
# Optional: leave blank for unbounded loop
AGENT_MAX_STEPS=
# Repeated-iteration cutoff (0 disables stall detection)
AGENT_STALL_LIMIT=4
# Global task-ledger poll interval in milliseconds (0 disables polling)
AGENT_TASK_LEDGER_POLL_INTERVAL_MS=15000
# Number of auto-dispatched ledger workers allowed to run at once
AGENT_TASK_LEDGER_MAX_AUTO_AGENTS=0
# Auto-restart interrupted threads on server restart for all workspaces.
# Ender self-root threads auto-restart by default even when this is unset.
AGENT_AUTO_RESTART_INTERRUPTED_THREADS=false
AGENT_SELF_UPDATE_VERIFY=npm run verify
AGENT_SELF_UPDATE_TIMEOUT_MS=90000
ENDER_SUPERVISOR_URL=
ENDER_SUPERVISOR_TOKEN=
# Shared cloud storage for Pillar and Beacon. Use in production instead of JSON files.
CLOUD_DATABASE_URL=
# auto prefers a local launcher on macOS and Docker elsewhere
CODE_SERVER_ENABLED=true
CODE_SERVER_MODE=auto
# Used for docker mode
CODE_SERVER_IMAGE=codercom/code-server:latest
CODE_SERVER_BIND_HOST=0.0.0.0
CODE_SERVER_PUBLIC_HOST=
CODE_SERVER_PUBLIC_PROTOCOL=
CODE_SERVER_HOST_WORKDIR=
CODE_SERVER_STATE_DIR=.ender-code-server
# Used for local mode
CODE_SERVER_COMMAND=code-server
# The pinned npm package currently expects Node 22 when used via npx
CODE_SERVER_NPX_PACKAGE=code-server@4.113.0

# Pillar lighthouse relay
# Cloud Pillar process:
PILLAR_PORT=8080
PILLAR_AUTH_MODE=legacy
PILLAR_DATABASE_URL=
PILLAR_DATA_FILE=pillar-data/pillar.json
PILLAR_OIDC_ISSUER=https://auth.ender.bot/realms/ender
PILLAR_OIDC_AUDIENCE=ender
PILLAR_OIDC_JWKS_URI=
PILLAR_CLIENT_TOKEN=
# Shared by the cloud Pillar process and this on-prem Ender API.
PILLAR_SERVER_TOKEN=
# On-prem Ender API outbound connector:
PILLAR_ENABLED=false
PILLAR_URL=
PILLAR_SERVER_ID=
PILLAR_LOCAL_BASE_URL=
PILLAR_INSTANCE_ID=
PILLAR_POLL_TIMEOUT_MS=25000
PILLAR_RETRY_DELAY_MS=2000
PILLAR_CAPACITY=4
PILLAR_STREAM_POLL_MS=1000
PILLAR_STREAM_HEARTBEAT_MS=15000

# Beacon notification hub
# Cloud Beacon process:
BEACON_PORT=8090
BEACON_PUBLIC_URL=https://beacon.ender.bot
BEACON_DATABASE_URL=
BEACON_DATA_FILE=beacon-data/beacon.json
BEACON_AUTH_MODE=oidc
KEYCLOAK_ISSUER=https://auth.ender.bot/realms/ender
KEYCLOAK_AUDIENCE=ender
BEACON_OIDC_JWKS_URI=
# On-prem Ender API notification connector:
BEACON_ENABLED=false
BEACON_URL=https://beacon.ender.bot
BEACON_SERVER_ID=
BEACON_SERVER_TOKEN=
# Native push providers used by Beacon cloud:
BEACON_FCM_PROJECT_ID=
BEACON_FCM_CLIENT_EMAIL=
BEACON_FCM_PRIVATE_KEY=
BEACON_APNS_TEAM_ID=
BEACON_APNS_KEY_ID=
BEACON_APNS_PRIVATE_KEY=
BEACON_APNS_BUNDLE_ID=
BEACON_APNS_ENV=production

# Default provider: openai | bedrock | azure | ollama | acp
# Ender also publishes every other provider whose required values below are configured.
LLM_BACKEND=openai
# Optional custom profile set. When set, this list is authoritative instead of automatic discovery.
# LLM_PROFILES_JSON='[{"id":"openai-fast","label":"OpenAI fast","backend":"openai","model":"gpt-4.1-mini"},{"id":"local","label":"Local Ollama","backend":"ollama","model":"llama3.1:8b"}]'
# Optional default profile id. Otherwise the LLM_BACKEND profile is selected first.
DEFAULT_LLM_PROFILE_ID=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional comma-separated additional models. The singular value remains the default profile.
OPENAI_MODELS=

# AWS Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5
# Optional comma-separated additional model or inference-profile IDs.
BEDROCK_MODEL_IDS=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_INSTANCE_NAME=
AZURE_OPENAI_API_DEPLOYMENT_NAME=
# Optional comma-separated additional deployment names.
AZURE_OPENAI_API_DEPLOYMENT_NAMES=
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional alternative to instance name:
# AZURE_OPENAI_BASE_PATH=https://<resource>.openai.azure.com/openai/deployments

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
# Optional comma-separated additional local models.
OLLAMA_MODELS=

# Codex through the maintained ACP adapter
# ACP_COMMAND=npx
# ACP_ARGS=--yes @agentclientprotocol/codex-acp
# Optional cold-start allowance for ACP initialize/newSession, default 30000
# ENDER_ACP_HANDSHAKE_TIMEOUT_MS=30000

# GitLab
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=

# GitHub
GITHUB_BASE_URL=https://github.com
GITHUB_TOKEN=

# Jira
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Confluence
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# Google Drive
GOOGLE_DRIVE_ACCESS_TOKEN=

# Email (SMTP send)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Email (IMAP list/read)
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
