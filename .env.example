# Runtime
PORT=3000
AGENT_WORKDIR=./workspace
AGENT_WORKSPACE_BASE=..
AGENT_THREADS_DIR=./threads
AGENT_SCHEDULES_DIR=./schedules
# Optional: leave blank for unbounded loop
AGENT_MAX_STEPS=
# Repeated-iteration cutoff (0 disables stall detection)
AGENT_STALL_LIMIT=4

# Provider selection: openai | bedrock | azure | ollama
LLM_BACKEND=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# AWS Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_INSTANCE_NAME=
AZURE_OPENAI_API_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional alternative to instance name:
# AZURE_OPENAI_BASE_PATH=https://<resource>.openai.azure.com/openai/deployments

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# GitLab
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=

# GitHub
GITHUB_BASE_URL=https://github.com
GITHUB_TOKEN=

# Jira
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Confluence
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# Google Drive
GOOGLE_DRIVE_ACCESS_TOKEN=

# Email (SMTP send)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Email (IMAP list/read)
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
