{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [
    "src/config.js",
    "src/shared/contracts.js",
    "src/workflows/workflowManager.js"
  ]
}
