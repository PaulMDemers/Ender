{
  "name": "ender-ui",
  "private": true,
  "version": "0.1.1",
  "description": "Electron desktop shell for the Ender agent operations console",
  "author": "Paul Demers",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env ELECTRON_RENDERER_URL=http://localhost:5173 electron .\"",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "41.2.1",
    "electron-builder": "^26.0.12",
    "vite": "^8.0.9",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.ender.ui",
    "productName": "Ender UI",
    "icon": "public/icons/electron-icon.png",
    "directories": {
      "buildResources": "public"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/icons/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "public/icons/electron-icon.icns",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "public/icons/electron-icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "public/icons/electron-icon-512.png",
      "target": [
        "AppImage"
      ]
    },
    "nsis": {
      "installerIcon": "public/icons/electron-icon.ico",
      "uninstallerIcon": "public/icons/electron-icon.ico",
      "installerHeaderIcon": "public/icons/electron-icon.ico"
    }
  }
}
